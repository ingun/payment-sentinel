# Kopyalayın: cp .env.example .env  (Windows: copy .env.example .env)
# Bu dosyada gerçek anahtar bulunmaz; .env git'e eklenmez.

# LLM sağlayıcı: ollama | gemini | none (none = deterministik politika modu)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434

# Gemini kullanılacaksa
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

LLM_TIMEOUT_S=90
LOG_LEVEL=INFO

# Analitik ve risk eşikleri (opsiyonel; varsayılan config/thresholds.toml)
# THRESHOLDS_PATH=config/thresholds.toml

# Veri kaynağı: synthetic | elasticsearch (opsiyonel, canlı kümede doğrulanmamış adaptör)
DATA_SOURCE=synthetic
ES_URL=http://localhost:9200
ES_INDEX=payment-events
ES_API_KEY=
ES_TIMEOUT_S=10
